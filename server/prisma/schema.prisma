model Message {
  id                String   @id @default(uuid())
  content           String
  isGhost           Boolean  @default(false)
  sessionId         String
  personalityId     String?  @db.VarChar
  moodAnalysis      Json?
  contextualFactors Json?
  imageUrl          String?  @db.VarChar
  imageAnalysis     Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  timestamp         DateTime @default(now())
  roomId            Int?

  room              Room?    @relation(fields: [roomId], references: [id])

  @@map("messages")
}

model Room {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  type              String   @default("haunted")
  description       String?
  privacy           String   @default("public")
  inviteCode        String?  @unique
  maxParticipants   Int      @default(10)
  participantCount  Int      @default(0)
  chatMode          String?  @default("balanced")
  aiModerationEnabled Boolean @default(true)
  aiInterventionDelay Int     @default(30)
  aiSettings        Json?
  conversationMetrics Json?
  ownerId           Int?
  decorations       Json?
  theme             Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  messages          Message[]
  users             RoomUser[]
}

model RoomUser {
  id        Int    @id @default(autoincrement())
  roomId    Int
  userId    String

  room      Room   @relation(fields: [roomId], references: [id])
  user      User   @relation(fields: [userId], references: [id])

  @@unique([roomId, userId])
}

